// skyforge-cron

функция разбить_поле(поле, минимум, максимум) {
    пусть результат = []
    для часть в разбить(поле, ",") {
        если часть == "*" {
            для i от минимум до максимум {
                результат = результат + [i]
            }
        } иначе {
            пусть значение = число(часть)
            если значение >= минимум и значение <= максимум {
                результат = результат + [значение]
            }
        }
    }
    вернуть результат
}

функция это_cron(выражение) {
    пусть части = разбить(выражение, " ")
    если длина(части) != 5 { вернуть ложь }
    вернуть истина
}

функция разобрать_cron(выражение) {
    пусть части = разбить(выражение, " ")
    если длина(части) != 5 { бросить "Ожидается 5 полей" }
    вернуть {
        "минута": разбить_поле(части[0], 0, 59),
        "час": разбить_поле(части[1], 0, 23),
        "день": разбить_поле(части[2], 1, 31),
        "месяц": разбить_поле(части[3], 1, 12),
        "день_недели": разбить_поле(части[4], 0, 6)
    }
}
